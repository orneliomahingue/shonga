generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum SalonStatus {
  PENDING
  APPROVED
  BLOCKED
  INACTIVE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum TimeOffType {
  VACATION
  ABSENCE
  BLOCKED
}

enum AppointmentStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  CREATED
  PENDING
  HELD
  FAILED
  EXPIRED
  DISPUTED
  RELEASED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  MPESA
}

model User {
  id                 String                     @id @default(uuid())
  email              String                     @unique
  passwordHash       String                     @map("password_hash")
  firstName          String                     @map("first_name")
  lastName           String                     @map("last_name")
  phone              String?                    @unique
  status             UserStatus                 @default(ACTIVE)
  roles              UserRole[]
  ownedSalons        Salon[]                    @relation("SalonOwner")
  employee           Employee?
  customer           Customer?
  refreshTokens      RefreshToken[]
  appointmentChanges AppointmentStatusHistory[]
  confirmedServices  ServiceConfirmation[]       @relation("ServiceConfirmedBy")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  deletedAt          DateTime?                  @map("deleted_at")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Salon {
  id           String        @id @default(uuid())
  ownerId      String        @map("owner_id")
  owner        User          @relation("SalonOwner", fields: [ownerId], references: [id])
  name         String
  slug         String        @unique
  description  String?
  nuit         String        @unique
  phone        String
  email        String?
  address      String
  province     String
  district     String
  neighborhood String?
  latitude     Decimal?      @db.Decimal(10, 7)
  longitude    Decimal?      @db.Decimal(10, 7)
  logoUrl      String?       @map("logo_url") @db.LongText
  rating       Decimal       @default(0) @db.Decimal(2, 1)
  status       SalonStatus   @default(PENDING)
  employees    Employee[]
  customers    Customer[]
  services     Service[]
  appointments Appointment[]
  payments     Payment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@index([latitude, longitude])
  @@index([status])
  @@map("salons")
}

model Province {
  id        String     @id @default(uuid())
  name      String     @unique
  sortOrder Int        @default(0) @map("sort_order")
  districts District[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("provinces")
}

model District {
  id         String   @id @default(uuid())
  provinceId String   @map("province_id")
  name       String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([provinceId, name])
  @@index([provinceId, name])
  @@map("districts")
}

model Employee {
  id           String            @id @default(uuid())
  salonId      String            @map("salon_id")
  userId       String            @unique @map("user_id")
  salon        Salon             @relation(fields: [salonId], references: [id])
  user         User              @relation(fields: [userId], references: [id])
  jobTitle     String            @map("job_title")
  specialty    String?
  photoUrl      String?           @map("photo_url") @db.LongText
  status       EmployeeStatus    @default(ACTIVE)
  hiredAt      DateTime?         @map("hired_at") @db.Date
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")
  services     EmployeeService[]
  workingHours WorkingHour[]
  timeOff      EmployeeTimeOff[]
  appointments Appointment[]

  @@index([salonId, status])
  @@map("employees")
}

model ServiceCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  active      Boolean   @default(true)
  services    Service[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([active])
  @@map("service_categories")
}

model Service {
  id           String            @id @default(uuid())
  salonId      String            @map("salon_id")
  categoryId   String            @map("category_id")
  name         String
  description  String?           @db.Text
  /// Enforced in the database by services_price_min_10_check.
  price        Decimal           @db.Decimal(12, 2)
  durationMin  Int               @map("duration_min")
  imageUrl     String?           @map("image_url")
  status       ServiceStatus     @default(ACTIVE)
  salon        Salon             @relation(fields: [salonId], references: [id])
  category     ServiceCategory   @relation(fields: [categoryId], references: [id])
  specialists  EmployeeService[]
  appointments Appointment[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  @@unique([salonId, name])
  @@index([categoryId, status])
  @@map("services")
}

model EmployeeService {
  employeeId String   @map("employee_id")
  serviceId  String   @map("service_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([employeeId, serviceId])
  @@map("employee_services")
}

model WorkingHour {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  dayOfWeek   Int      @map("day_of_week") @db.TinyInt
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  active      Boolean  @default(true)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([employeeId, dayOfWeek, startMinute, endMinute])
  @@index([employeeId, dayOfWeek, active])
  @@map("working_hours")
}

model EmployeeTimeOff {
  id         String      @id @default(uuid())
  employeeId String      @map("employee_id")
  startsAt   DateTime    @map("starts_at")
  endsAt     DateTime    @map("ends_at")
  type       TimeOffType
  reason     String?
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([employeeId, startsAt, endsAt])
  @@map("employee_time_off")
}

model Appointment {
  id         String                     @id @default(uuid())
  salonId    String                     @map("salon_id")
  customerId String                     @map("customer_id")
  employeeId String                     @map("employee_id")
  serviceId  String                     @map("service_id")
  startsAt   DateTime                   @map("starts_at")
  endsAt     DateTime                   @map("ends_at")
  total      Decimal                    @db.Decimal(12, 2)
  notes      String?                    @db.Text
  status     AppointmentStatus          @default(PENDING)
  salon      Salon                      @relation(fields: [salonId], references: [id])
  customer   Customer                   @relation(fields: [customerId], references: [id])
  employee   Employee                   @relation(fields: [employeeId], references: [id])
  service    Service                    @relation(fields: [serviceId], references: [id])
  history    AppointmentStatusHistory[]
  payment    Payment?
  confirmation ServiceConfirmation?
  createdAt  DateTime                   @default(now()) @map("created_at")
  updatedAt  DateTime                   @updatedAt @map("updated_at")

  @@index([customerId, startsAt])
  @@index([salonId, startsAt])
  @@index([employeeId, startsAt, endsAt, status])
  @@map("appointments")
}

model Payment {
  id                  String          @id @default(uuid())
  reference           String          @unique
  appointmentId       String          @unique @map("appointment_id")
  salonId             String          @map("salon_id")
  provider             PaymentProvider @default(MPESA)
  status               PaymentStatus   @default(CREATED)
  phone                 String
  amount                Decimal         @db.Decimal(12, 2)
  commissionAmount      Decimal         @map("commission_amount") @db.Decimal(12, 2)
  salonAmount           Decimal         @map("salon_amount") @db.Decimal(12, 2)
  providerTransactionId String?         @unique @map("provider_transaction_id")
  providerCode          String?         @map("provider_code")
  providerMessage       String?         @map("provider_message")
  expiresAt             DateTime         @map("expires_at")
  paidAt                DateTime?        @map("paid_at")
  releasedAt            DateTime?        @map("released_at")
  refundedAt            DateTime?        @map("refunded_at")
  refundAmount          Decimal?         @map("refund_amount") @db.Decimal(12, 2)
  transactionFeeAmount  Decimal?         @map("transaction_fee_amount") @db.Decimal(12, 2)
  appointment           Appointment      @relation(fields: [appointmentId], references: [id])
  salon                 Salon            @relation(fields: [salonId], references: [id])
  events                PaymentEvent[]
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([salonId, status])
  @@index([status, expiresAt])
  @@map("payments")
}

model PaymentEvent {
  id        String        @id @default(uuid())
  paymentId String        @map("payment_id")
  fromStatus PaymentStatus? @map("from_status")
  toStatus  PaymentStatus @map("to_status")
  source    String
  detail    String?       @db.Text
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model ServiceConfirmation {
  id             String      @id @default(uuid())
  appointmentId  String      @unique @map("appointment_id")
  pinHash        String      @map("pin_hash")
  qrTokenHash    String      @unique @map("qr_token_hash")
  failedAttempts Int         @default(0) @map("failed_attempts")
  expiresAt      DateTime    @map("expires_at")
  confirmedAt    DateTime?   @map("confirmed_at")
  confirmedById  String?     @map("confirmed_by_id")
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  confirmedBy    User?       @relation("ServiceConfirmedBy", fields: [confirmedById], references: [id])
  createdAt      DateTime    @default(now()) @map("created_at")

  @@map("service_confirmations")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid())
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  changedById   String             @map("changed_by_id")
  reason        String?
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy     User               @relation(fields: [changedById], references: [id])
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model Customer {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  salonId      String?       @map("salon_id")
  user         User          @relation(fields: [userId], references: [id])
  salon        Salon?        @relation(fields: [salonId], references: [id])
  appointments Appointment[]
  birthDate    DateTime?     @map("birth_date") @db.Date
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  @@index([salonId])
  @@map("customers")
}

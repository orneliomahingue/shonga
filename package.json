{
  "name": "shonga-project",
  "version": "0.0.1",
  "description": "Projecto shonga",
  "productName": "Shonga App",
  "author": "Ornelio Mahingue <70206383+orneliomahingue@users.noreply.github.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "concurrently --kill-others-on-fail --names API,APP --prefix-colors magenta,cyan \"npm --prefix shonga-api run dev\" \"quasar dev\"",
    "dev:api": "npm --prefix shonga-api run dev",
    "dev:app": "quasar dev",
    "build": "quasar build",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@apollo/client": "^4.2.12",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.13.6",
    "graphql": "^16.14.2",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.5.22",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@quasar/app-vite": "^2.5.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
